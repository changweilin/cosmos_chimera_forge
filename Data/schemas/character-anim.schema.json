{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/character-anim.schema.json",
  "title": "Character rig, 7-slot sockets, and player-master animation format (art-asset-pipeline.md#動作)",
  "description": "Per-grip animation clip format, Unity Humanoid rig constraints, and 7-slot equipment socket bindings for player/NPC character GLB animation generation.",
  "type": "array",
  "minItems": 3,
  "maxItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "spec",
      "rig_type",
      "max_bones",
      "grip_mode",
      "fps",
      "clip_prefix_pattern",
      "alternates_hands",
      "equipment_slots",
      "sockets",
      "pose_rules",
      "weapon_types",
      "clips"
    ],
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "spec": { "const": "cosmimera-character-anim/1" },
      "rig_type": { "const": "unity_humanoid" },
      "max_bones": { "const": 75 },
      "bind_pose": { "const": "t_pose" },
      "showcase_clip": { "const": "Idle_Art" },
      "rig_conventions": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["unity_humanoid", "mpfb_game_engine"] }
      },
      "spring_bone_prefix": { "const": "sw_" },
      "spring_end_suffix": { "const": "_end" },
      "grip_mode": {
        "enum": ["two_handed", "dual_wield", "one_hand_shield"]
      },
      "fps": { "const": 30 },
      "clip_prefix_pattern": { "const": "chr_" },
      "alternates_hands": { "type": "boolean" },
      "animator_parameters": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "equipment_slots": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "uniqueItems": true,
        "items": {
          "enum": ["main_hand", "off_hand", "head", "upper", "hands", "lower", "accessory"]
        }
      },
      "sockets": {
        "type": "array",
        "minItems": 7,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "role", "required"],
          "properties": {
            "name": {
              "enum": [
                "Socket_HandR_Prop",
                "Socket_HandL_Prop",
                "Socket_Head_Armor",
                "Socket_Hands_Armor",
                "Socket_Back_Pack",
                "Socket_Throw",
                "Socket_Head_FX"
              ]
            },
            "role": {
              "enum": [
                "main_weapon",
                "two_hand_support",
                "off_weapon",
                "off_shield",
                "head_armor",
                "hands_armor",
                "backpack",
                "throw_origin",
                "head_fx"
              ]
            },
            "required": { "type": "boolean" }
          }
        }
      },
      "pose_rules": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idle_stance",
          "locomotion_rule",
          "crouch_rule",
          "guard_rule",
          "attack_rule",
          "ranged_rule",
          "moveset_switch_rule",
          "equipment_clearance_rule"
        ],
        "properties": {
          "idle_stance": { "type": "string", "minLength": 1 },
          "locomotion_rule": { "type": "string", "minLength": 1 },
          "crouch_rule": { "type": "string", "minLength": 1 },
          "guard_rule": { "type": "string", "minLength": 1 },
          "attack_rule": { "type": "string", "minLength": 1 },
          "ranged_rule": { "type": "string", "minLength": 1 },
          "moveset_switch_rule": { "type": "string", "minLength": 1 },
          "equipment_clearance_rule": { "type": "string", "minLength": 1 }
        }
      },
      "weapon_types": {
        "type": "object",
        "additionalProperties": false,
        "required": ["melee", "ranged"],
        "properties": {
          "melee": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/id" },
            "uniqueItems": true
          },
          "ranged": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/id" },
            "uniqueItems": true
          },
          "offhand": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/id" },
            "uniqueItems": true
          }
        }
      },
      "clips": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "description",
            "category",
            "weapon_distance",
            "hand",
            "frames",
            "duration_ms",
            "loop",
            "root_motion",
            "active_sockets",
            "events",
            "motion_notes"
          ],
          "properties": {
            "action_id": { "$ref": "common.schema.json#/$defs/id" },
            "description": { "type": "string", "minLength": 1 },
            "category": {
              "enum": [
                "stance",
                "locomotion",
                "guard",
                "combat_state",
                "moveset_switch",
                "melee",
                "dash",
                "ranged",
                "support",
                "command",
                "item",
                "life_skill",
                "social"
              ]
            },
            "weapon_distance": { "enum": ["any", "melee", "ranged"] },
            "hand": { "enum": ["both", "right", "left", "off_shield", "none"] },
            "frames": { "$ref": "common.schema.json#/$defs/positiveInt" },
            "duration_ms": { "$ref": "common.schema.json#/$defs/positiveInt" },
            "loop": { "type": "boolean" },
            "root_motion": { "type": "boolean" },
            "active_sockets": {
              "type": "array",
              "items": {
                "enum": [
                  "Socket_HandR_Prop",
                  "Socket_HandL_Prop",
                  "Socket_Head_Armor",
                  "Socket_Hands_Armor",
                  "Socket_Back_Pack",
                  "Socket_Throw",
                  "Socket_Head_FX"
                ]
              },
              "uniqueItems": true
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "frame", "time_ms"],
                "properties": {
                  "name": {
                    "enum": ["ev_hit", "ev_spawn_fx", "ev_release", "ev_footstep", "ev_end_lock"]
                  },
                  "frame": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
                  "time_ms": { "$ref": "common.schema.json#/$defs/nonNegativeInt" }
                }
              }
            },
            "motion_notes": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
